{
  "name": "gulp-template",
  "description": "Modern Gulp 5 template for fast frontend development",
  "version": "3.2.2",
  "private": true,
  "type": "module",
  "author": "HolyMolly",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "node gulp/utils/prepare.js",
    "dev": "cross-env NODE_ENV=development gulp dev",
    "build:dev": "cross-env NODE_ENV=development gulp build:dev",
    "build:prod": "cross-env NODE_ENV=production gulp build:prod",
    "preview": "pnpm build:prod && cross-env NODE_ENV=production gulp preview",
    "serve": "cross-env NODE_ENV=production gulp preview",
    "zip": "pnpm build:prod && node .template/setup/zip.js",
    "lint": "eslint . --fix --cache --cache-location .eslintcache && stylelint \"src/**/*.{css,scss}\" --fix --cache",
    "lint:check": "eslint . --max-warnings 0 --cache --cache-location .eslintcache && stylelint \"src/**/*.{css,scss}\" --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tailwind:setup": "node .template/setup/tailwind/setup.js",
    "clean:demo": "node .template/setup/clean-demo.js",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "clean:cache": "node -e \"['node_modules/.cache', '.eslintcache', '.stylelintcache'].forEach((p) => fs.rmSync(p, { recursive: true, force: true }))\"",
    "clean:all": "node -e \"['node_modules', 'dist'].forEach((p) => fs.rmSync(p, { recursive: true, force: true }))\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "autoprefixer": "^10.4.21",
    "browser-sync": "^3.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.2.0",
    "gulp": "^5.0.1",
    "gulp-file-include": "^2.3.0",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-size": "^5.0.0",
    "gulp-svg-sprite": "^2.0.3",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.3",
    "postcss-sort-media-queries": "^6.1.0",
    "prettier": "^3.8.0",
    "sass-embedded": "^1.97.0",
    "sharp": "^0.35.4",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svgo": "^4.0.1",
    "terser": "^5.51.2"
  }
}
